<launch>
  <arg name="left_ip" default="192.168.1.181"/>
  <arg name="right_ip" default="192.168.1.188"/>

  <group ns="left_arm">
    <param name="ip" value="$(arg left_ip)" type="str"/>
    <node pkg="jaka_driver" type="jaka_driver" name="jaka_driver" output="screen"/>
  </group>

  <group ns="right_arm">
    <param name="ip" value="$(arg right_ip)" type="str"/>
    <node pkg="jaka_driver" type="jaka_driver" name="jaka_driver" output="screen"/>
  </group>
</launch>
