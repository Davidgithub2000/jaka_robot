<launch>
  <include file="$(find jaka_handeye_calibration)/launch/solve_handeye.launch">
    <arg name="arm" value="left"/>
    <arg name="samples_file" value="$(env HOME)/jaka_handeye_calibration/left/samples.yaml"/>
    <arg name="result_file" value="$(env HOME)/jaka_handeye_calibration/left/handeye_result.yaml"/>
    <arg name="parent_frame" value="left_tool0"/>
    <arg name="child_frame" value="left_camera_color_optical_frame"/>
  </include>

  <include file="$(find jaka_handeye_calibration)/launch/solve_handeye.launch">
    <arg name="arm" value="right"/>
    <arg name="samples_file" value="$(env HOME)/jaka_handeye_calibration/right/samples.yaml"/>
    <arg name="result_file" value="$(env HOME)/jaka_handeye_calibration/right/handeye_result.yaml"/>
    <arg name="parent_frame" value="right_tool0"/>
    <arg name="child_frame" value="right_camera_color_optical_frame"/>
  </include>
</launch>
