<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="arm_body">
  <xacro:macro name="arm_body" params="parent_prefix *joint_pose">
 
  <xacro:arg name="default_velocity" default="1" /> 

  <link name="arm_base_link">
    <inertial>
      <origin xyz="-0.00018006 1.07690000000008E-05 0.013295" rpy="0 0 0" />
      <mass value="0.28093" />
      <inertia ixx="0.00024785" ixy="-3.0829E-08" ixz="-5.1975E-07" iyy="0.0002461" iyz="-3.19E-08" izz="0.00045567" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh filename="package://jaka_description/meshes/jaka_minicobo_meshes/link_0.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh filename="package://jaka_description/meshes/jaka_minicobo_meshes/link_0.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="arm_base_joint" type="fixed">
    <xacro:insert_block name="joint_pose"/>
    <parent link="${parent_prefix}" />
    <child link="arm_base_link" />
    <axis xyz="0 0 0" />
  </joint>

  <link name="shoulder_pan_link">
    <inertial>
      <origin xyz="9.9123E-05 0.01341 0.09734" rpy="0 0 0" />
      <mass value="1.3529" />
      <inertia ixx="0.0054998" ixy="-2.716E-07" ixz="-3.4974E-06" iyy="0.0054317" iyz="0.00069142" izz="0.0016731" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh filename="package://jaka_description/meshes/jaka_minicobo_meshes/link_1.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh filename="package://jaka_description/meshes/jaka_minicobo_meshes/link_1.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="shoulder_pan_joint" type="continuous">
    <origin xyz="0 0 0.028" rpy="0 0 0" />
    <parent link="arm_base_link" />
    <child link="shoulder_pan_link" />
    <axis xyz="0 0 1" />
    <limit lower="-3" upper="3" effort="49" velocity="$(arg default_velocity)" />
  </joint>

  <link name="shoulder_lift_link">
    <inertial>
      <origin xyz="-2.5363E-05 0.090565 0.00442809999999999" rpy="0 0 0" />
      <mass value="1.1377" />
      <inertia ixx="0.0082035" ixy="-2.0097E-06" ixz="9.4198E-07" iyy="0.0021505" iyz="-0.0025443" izz="0.0072548" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh filename="package://jaka_description/meshes/jaka_minicobo_meshes/link_2.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh filename="package://jaka_description/meshes/jaka_minicobo_meshes/link_2.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="shoulder_lift_joint" type="continuous">
    <origin xyz="0 0.006 0.159" rpy="1.5708 0 0" />
    <parent link="shoulder_pan_link" />
    <child link="shoulder_lift_link" />
    <axis xyz="0 0 1" />
    <limit lower="-3" upper="3" effort="49" velocity="$(arg default_velocity)" />
  </joint>

  <link name="elbow_link">
    <inertial>
      <origin xyz="-4.0304E-05 0.042188 0.012484" rpy="0 0 0" />
      <mass value="0.81111" />
      <inertia ixx="0.0022134" ixy="-1.6101E-06" ixz="-8.7803E-07" iyy="0.00070261" iyz="-0.00022493" izz="0.0021173" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh filename="package://jaka_description/meshes/jaka_minicobo_meshes/link_3.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh filename="package://jaka_description/meshes/jaka_minicobo_meshes/link_3.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="elbow_joint" type="continuous">
    <origin xyz="0 0.210 0" rpy="0 0 0" />
    <parent link="shoulder_lift_link" />
    <child link="elbow_link" />
    <axis xyz="0 0 1" />
    <limit lower="-3" upper="3" effort="49" velocity="$(arg default_velocity)" />
  </joint>

  <link name="wrist_1_link">
    <inertial>
      <origin xyz="2.9484E-06 -0.025942 0.045273" rpy="0 0 0" />
      <mass value="0.3089" />
      <inertia ixx="0.00048582" ixy="3.9055E-09" ixz="1.7169E-08" iyy="0.0004663" iyz="-0.00011075" izz="0.00023489" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh filename="package://jaka_description/meshes/jaka_minicobo_meshes/link_4.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh filename="package://jaka_description/meshes/jaka_minicobo_meshes/link_4.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="wrist_1_joint" type="continuous">
    <origin xyz="0 0.1303 0" rpy="-1.5708 0 0" />
    <parent link="elbow_link" />
    <child link="wrist_1_link" />
    <axis xyz="0 0 1" />
    <limit lower="-3" upper="3" effort="11" velocity="$(arg default_velocity)" />
  </joint>

  <link name="wrist_2_link">
    <inertial>
      <origin xyz="1.9626E-06 0.044545 -0.010248" rpy="0 0 0" />
      <mass value="0.69157" />
      <inertia ixx="0.0016775" ixy="-1.4833E-07" ixz="2.784E-08" iyy="0.00053632" iyz="0.00016462" izz="0.001608" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh filename="package://jaka_description/meshes/jaka_minicobo_meshes/link_5.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh filename="package://jaka_description/meshes/jaka_minicobo_meshes/link_5.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="wrist_2_joint" type="continuous">
    <origin xyz="0 0 0.0802" rpy="1.5708 0 0" />
    <parent link="wrist_1_link" />
    <child link="wrist_2_link" />
    <axis xyz="0 0 1" />
    <limit lower="-3" upper="3" effort="11" velocity="$(arg default_velocity)" />
  </joint>

  <link name="wrist_3_link">
    <inertial>
      <origin xyz="-1.7983E-05 -3.74010000000012E-05 -0.020293" rpy="0 0 0" />
      <mass value="0.14776" />
      <inertia ixx="6.7361E-05" ixy="-2.38E-08" ixz="6.9658E-08" iyy="6.8321E-05" iyz="8.9675E-08" izz="0.00010506" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh filename="package://jaka_description/meshes/jaka_minicobo_meshes/link_6.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh filename="package://jaka_description/meshes/jaka_minicobo_meshes/link_6.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="wrist_3_joint" type="continuous">
    <origin xyz="0 0.1593 0" rpy="-1.5708 0 0" />
    <parent link="wrist_2_link" />
    <child link="wrist_3_link" />
    <axis xyz="0 0 1" />
    <limit lower="-3" upper="3" effort="11" velocity="$(arg default_velocity)" />
  </joint>


  <!-- Transmissions for ROS Control -->
  <xacro:macro name="transmission_block" params="joint_name">
    <transmission name="${joint_name}_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${joint_name}">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="${joint_name}_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>
  
  <xacro:transmission_block joint_name="shoulder_pan_joint"/>
  <xacro:transmission_block joint_name="shoulder_lift_joint"/>
  <xacro:transmission_block joint_name="elbow_joint"/>
  <xacro:transmission_block joint_name="wrist_1_joint"/>
  <xacro:transmission_block joint_name="wrist_2_joint"/>
  <xacro:transmission_block joint_name="wrist_3_joint"/>	

	<!-- ros_control plugin -->
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/jaka_minicobo</robotNamespace>
      <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
      <legacyModeNS>true</legacyModeNS>
    </plugin>
  </gazebo>

  </xacro:macro>
</robot>
