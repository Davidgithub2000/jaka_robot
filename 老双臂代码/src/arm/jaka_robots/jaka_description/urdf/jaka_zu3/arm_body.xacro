<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="arm_body">
  <xacro:macro name="arm_body" params="parent_prefix *joint_pose">
  
  <xacro:arg name="default_velocity" default="1" /> 

  <link name="arm_base_link">
    <inertial>
      <origin
        xyz="-0.0015673 1.77850000000031E-05 0.05088"
        rpy="0 0 0" />
      <mass
        value="0.46392" />
      <inertia
        ixx="0.00064493"
        ixy="-9.92249999999993E-08"
        ixz="-1.0723E-05"
        iyy="0.00065156"
        iyz="-3.78539999999989E-07"
        izz="0.00083276" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh
          filename="package://jaka_description/meshes/jaka_zu3_meshes/link_0.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh
          filename="package://jaka_description/meshes/jaka_zu3_meshes/link_0.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="arm_base_joint" type="fixed">
    <xacro:insert_block name="joint_pose"/>
    <parent link="${parent_prefix}" />
    <child link="arm_base_link" />
    <axis xyz="0 0 0" />
  </joint>

  <link name="shoulder_pan_link">
    <inertial>
      <origin
        xyz="-1.6776E-07 -0.0039623 -0.0033443"
        rpy="0 0 0" />
      <mass
        value="0.89667" />
      <inertia
        ixx="0.0016001"
        ixy="-1.969E-08"
        ixz="1.9711E-09"
        iyy="0.0015182"
        iyz="-1.1122E-05"
        izz="0.0010892" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh
          filename="package://jaka_description/meshes/jaka_zu3_meshes/link_1.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh
          filename="package://jaka_description/meshes/jaka_zu3_meshes/link_1.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="shoulder_pan_joint" type="continuous">
    <origin xyz="0 0 0.15055" rpy="0 0 0" />
    <parent link="arm_base_link" />
    <child link="shoulder_pan_link" />
    <axis xyz="0 0 1" />
    <limit lower="-3" upper="3" effort="49" velocity="$(arg default_velocity)" />
  </joint>

  <link name="shoulder_lift_link">
    <inertial>
      <origin
        xyz="-0.11439 4.56850000071297E-08 0.11644"
        rpy="0 0 0" />
      <mass
        value="2.3246" />
      <inertia
        ixx="0.0032395"
        ixy="7.60910000001259E-09"
        ixz="-0.00020566"
        iyy="0.027696"
        iyz="-3.73300000063435E-10"
        izz="0.02666" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh
          filename="package://jaka_description/meshes/jaka_zu3_meshes/link_2.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh
          filename="package://jaka_description/meshes/jaka_zu3_meshes/link_2.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="shoulder_lift_joint" type="continuous">
    <origin xyz="0 0 0" rpy="1.57079 0 0" />
    <parent link="shoulder_pan_link" />
    <child link="shoulder_lift_link" />
    <axis xyz="0 0 -1" />
    <limit lower="-3" upper="3" effort="49" velocity="$(arg default_velocity)" />
  </joint>

  <link name="elbow_link">
    <inertial>
      <origin
        xyz="-0.13616 5.15790000000444E-07 0.0072442"
        rpy="0 0 0" />
      <mass
        value="1.176" />
      <inertia
        ixx="0.0011462"
        ixy="-9.01440000000014E-08"
        ixz="2.3422E-05"
        iyy="0.010594"
        iyz="-7.30100000002853E-09"
        izz="0.010128" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh
          filename="package://jaka_description/meshes/jaka_zu3_meshes/link_3.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh
          filename="package://jaka_description/meshes/jaka_zu3_meshes/link_3.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="elbow_joint" type="continuous">
    <origin xyz="-0.248 0 0" rpy="0 0 0" />
    <parent link="shoulder_lift_link" />
    <child link="elbow_link" />
    <axis xyz="0 0 -1" />
    <limit lower="-3" upper="3" effort="49" velocity="$(arg default_velocity)" />
  </joint>

  <link name="wrist_1_link">
    <inertial>
      <origin
        xyz="2.284E-08 -0.014052 -0.0031609"
        rpy="0 0 0" />
      <mass
        value="0.49334" />
      <inertia
        ixx="0.00074574"
        ixy="-4.47990000000001E-11"
        ixz="1.1613E-09"
        iyy="0.00032983"
        iyz="-2.5248E-05"
        izz="0.0007175" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh
          filename="package://jaka_description/meshes/jaka_zu3_meshes/link_4.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh
          filename="package://jaka_description/meshes/jaka_zu3_meshes/link_4.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="wrist_1_joint" type="continuous">
    <origin xyz="-0.227796 0 0.1175" rpy="0 0 0" />
    <parent link="elbow_link" />
    <child link="wrist_1_link" />
    <axis xyz="0 0 -1" />
    <limit lower="-3" upper="3" effort="11" velocity="$(arg default_velocity)" />
  </joint>

  <link name="wrist_2_link">
    <inertial>
      <origin
        xyz="-8.4104E-09 0.0068633 -0.0029081"
        rpy="0 0 0" />
      <mass
        value="0.55083" />
      <inertia
        ixx="0.0010067"
        ixy="-1.5603E-09"
        ixz="-4.1167E-09"
        iyy="0.00036029"
        iyz="1.6676E-05"
        izz="0.00097818" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh
          filename="package://jaka_description/meshes/jaka_zu3_meshes/link_5.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh
          filename="package://jaka_description/meshes/jaka_zu3_meshes/link_5.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="wrist_2_joint" type="continuous">
    <origin xyz="0 -0.1175 0" rpy="1.57079 3.1415926 0" />
    <parent link="wrist_1_link" />
    <child link="wrist_2_link" />
    <axis xyz="0 0 1" />
    <limit lower="-3" upper="3" effort="11" velocity="$(arg default_velocity)" />
  </joint>

  <link name="wrist_3_link">
    <inertial>
      <origin
        xyz="-4.9727E-05 2.9711999999999E-05 -0.016372"
        rpy="0 0 0" />
      <mass
        value="0.10033" />
      <inertia
        ixx="3.5902E-05"
        ixy="-8.8868E-08"
        ixz="5.6844E-08"
        iyy="3.6313E-05"
        iyz="7.66520000000013E-08"
        izz="5.8133E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh
          filename="package://jaka_description/meshes/jaka_zu3_meshes/link_6.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="1.5707963267949 0 0" />
      <geometry>
        <mesh
          filename="package://jaka_description/meshes/jaka_zu3_meshes/link_6.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="wrist_3_joint" type="continuous">
    <origin xyz="0 0.105 0" rpy="-1.57079 0 0" />
    <parent link="wrist_2_link" />
    <child link="wrist_3_link" />
    <axis xyz="0 0 1" />
    <limit lower="-3" upper="3" effort="11" velocity="$(arg default_velocity)" />
  </joint>


  <!-- Transmissions for ROS Control -->
  <xacro:macro name="transmission_block" params="joint_name">
    <transmission name="${joint_name}_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${joint_name}">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="${joint_name}_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>
  
  <xacro:transmission_block joint_name="shoulder_pan_joint"/>
  <xacro:transmission_block joint_name="shoulder_lift_joint"/>
  <xacro:transmission_block joint_name="elbow_joint"/>
  <xacro:transmission_block joint_name="wrist_1_joint"/>
  <xacro:transmission_block joint_name="wrist_2_joint"/>
  <xacro:transmission_block joint_name="wrist_3_joint"/>	

	<!-- ros_control plugin -->
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/jaka_zu3</robotNamespace>
      <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
      <legacyModeNS>true</legacyModeNS>
    </plugin>
  </gazebo>

  </xacro:macro>
</robot>
